# These variables can also be passed as command-line flags:
#   --server / BITWARDEN_SERVER
#   --proxy  / BITWARDEN_PROXY
#   --bind   / BITWARDEN_PROXY_BIND
# Flags take precedence over environment variables.

# The Bitwarden server to forward requests to.
# Use "bitwarden.com" or "bitwarden.eu" for the official cloud servers, or an
# origin such as "https://bw.example.com" for a self-hosted installation.
BITWARDEN_SERVER=bitwarden.com

# Public origin of this proxy (the URL entered in the Bitwarden client).
# Must not contain a path or trailing slash.
BITWARDEN_PROXY=https://bitwarden-proxy.example.com

# Listen address of the plain-HTTP server.
BITWARDEN_PROXY_BIND=0.0.0.0:8080

# RUST_LOG=info
